+++ b/tests/transforms_a2a_test.py
@@ -0,0 +1,45 @@
+# Pi0.5 A2A data transform tests.
+import numpy as np
+
+from openpi import transforms
+from openpi.models.model import ModelType
+from openpi.policies.libero_policy import LiberoInputs
+
+
+def test_split_past_future_alignment_and_mask():
+    actions = np.arange(20 * 7, dtype=np.float32).reshape(20, 7)
+    is_pad = np.array([True] * 7 + [False] * 13)
+    out = transforms.SplitPastAndFutureActions(10)({"actions": actions, "actions_is_pad": is_pad})
+
+    np.testing.assert_array_equal(out["past_actions"], actions[:10])
+    np.testing.assert_array_equal(out["actions"], actions[10:])
+    np.testing.assert_array_equal(out["past_action_valid_mask"], ~is_pad[:10])
+
+
+def test_gripper_is_not_part_of_continuous_noise_mask():
+    continuous_dim = 6
+    mask = np.arange(7) < continuous_dim
+    np.testing.assert_array_equal(mask, [True, True, True, True, True, True, False])
+
+
+def test_flow_velocity_sign_and_one_step_endpoint():
+    source = np.array([[[0.4, -0.2]]], dtype=np.float32)
+    future = np.array([[[0.1, 0.3]]], dtype=np.float32)
+    velocity = source - future
+    endpoint = source - velocity
+    np.testing.assert_allclose(velocity, [[[0.3, -0.5]]])
+    np.testing.assert_allclose(endpoint, future)
+
+
+def test_libero_inputs_preserve_future_action_validity():
+    image = np.zeros((224, 224, 3), dtype=np.uint8)
+    result = LiberoInputs(model_type=ModelType.PI05)(
+        {
+            "observation/image": image,
+            "observation/wrist_image": image,
+            "observation/state": np.zeros(8, dtype=np.float32),
+            "actions": np.zeros((10, 7), dtype=np.float32),
+            "actions_is_pad": np.array([False] * 8 + [True] * 2),
+        }
+    )
+    np.testing.assert_array_equal(result["action_valid_mask"], [True] * 8 + [False] * 2)
