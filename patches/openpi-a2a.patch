+++ b/tests/test_pi05_jax_lora.py
@@ -0,0 +1,40 @@
+# Pi0.5 A2A JAX source and preprocessing tests.
+import jax.numpy as jnp
+import numpy as np
+
+from openpi.models import model
+from openpi.models.pi0 import make_past_action_source
+from openpi.models.pi0 import posemb_sincos
+
+
+def test_past_action_source_noise_excludes_gripper_and_padding():
+    past = jnp.arange(2 * 10 * 32, dtype=jnp.float32).reshape(2, 10, 32)
+    noise = jnp.ones_like(past)
+    source = make_past_action_source(past, noise, noise_std=0.5, continuous_dim=6)
+    np.testing.assert_allclose(np.asarray(source[..., :6] - past[..., :6]), 0.5)
+    np.testing.assert_array_equal(np.asarray(source[..., 6:]), np.asarray(past[..., 6:]))
+
+
+def test_tokenwise_time_embedding_matches_scalar_embedding():
+    time = jnp.array([0.2, 0.8], dtype=jnp.float32)
+    scalar = posemb_sincos(time, 64, 4e-3, 4.0)
+    tokenwise = posemb_sincos(jnp.broadcast_to(time[:, None], (2, 10)), 64, 4e-3, 4.0)
+    assert tokenwise.shape == (2, 10, 64)
+    np.testing.assert_allclose(np.asarray(tokenwise[:, 0]), np.asarray(scalar))
+
+
+def test_observation_preprocessing_retains_action_history_and_masks():
+    images = {k: jnp.zeros((1, 224, 224, 3), dtype=jnp.float32) for k in model.IMAGE_KEYS}
+    masks = {k: jnp.ones((1,), dtype=jnp.bool_) for k in model.IMAGE_KEYS}
+    obs = model.Observation(
+        images=images,
+        image_masks=masks,
+        state=jnp.zeros((1, 32), dtype=jnp.float32),
+        past_actions=jnp.ones((1, 10, 32), dtype=jnp.float32),
+        past_action_valid_mask=jnp.ones((1, 10), dtype=jnp.bool_),
+        action_valid_mask=jnp.ones((1, 10), dtype=jnp.bool_),
+    )
+    output = model.preprocess_observation(None, obs, train=False)
+    assert output.past_actions is obs.past_actions
+    assert output.past_action_valid_mask is obs.past_action_valid_mask
+    assert output.action_valid_mask is obs.action_valid_mask
