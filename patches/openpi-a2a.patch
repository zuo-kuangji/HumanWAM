new file mode 100644
index 0000000..2b05044
--- /dev/null
+++ b/scripts/compute_libero_norm_stats_fast.py
@@ -0,0 +1,50 @@
+"""Compute OpenPI LIBERO normalization stats without decoding image columns."""
+
+from pathlib import Path
+
+import numpy as np
+import pyarrow.parquet as pq
+import tqdm
+import tyro
+
+from openpi.shared import normalize
+from openpi.training import config as _config
+
+
+def main(config_name: str = "pi05_libero_a2a_jax_lora_warmup_cosine", dataset_root: Path | None = None) -> None:
+    config = _config.get_config(config_name)
+    if dataset_root is None:
+        dataset_root = Path.home() / ".cache/huggingface/lerobot/physical-intelligence/libero"
+
+    states: list[np.ndarray] = []
+    action_chunks: list[np.ndarray] = []
+    files = sorted((dataset_root / "data").glob("chunk-*/episode_*.parquet"))
+    for path in tqdm.tqdm(files, desc="Reading state/action columns"):
+        table = pq.read_table(path, columns=["state", "actions"])
+        state = np.asarray(table["state"].to_pylist(), dtype=np.float32)
+        actions = np.asarray(table["actions"].to_pylist(), dtype=np.float32)
+        indices = np.minimum(
+            np.arange(len(actions))[:, None] + np.arange(config.model.action_horizon)[None, :],
+            len(actions) - 1,
+        )
+        states.append(state)
+        action_chunks.append(actions[indices])
+
+    state_values = np.concatenate(states)
+    action_values = np.concatenate(action_chunks)
+    stats = {"state": normalize.RunningStats(), "actions": normalize.RunningStats()}
+    usable = len(state_values) // config.batch_size * config.batch_size
+    for start in tqdm.trange(0, usable, config.batch_size, desc="Computing stats"):
+        end = start + config.batch_size
+        stats["state"].update(state_values[start:end])
+        stats["actions"].update(action_values[start:end])
+
+    output = {key: value.get_statistics() for key, value in stats.items()}
+    data_config = config.data.create(config.assets_dirs, config.model)
+    output_path = Path(config.data.assets.assets_dir or config.assets_dirs) / data_config.asset_id
+    normalize.save(output_path, output)
+    print(f"Wrote normalization statistics to {output_path}")
+
+
+if __name__ == "__main__":
+    tyro.cli(main)
