         return data
 
 
+@dataclasses.dataclass(frozen=True)
+class SplitPastAndFutureActions(DataTransformFn):
+    """Split one LeRobot query into past history and future targets."""
+
+    past_horizon: int
+
+    def __call__(self, data: DataDict) -> DataDict:
+        actions = data["actions"]
+        is_pad = data["actions_is_pad"]
+        expected = 2 * self.past_horizon
+        if actions.shape[0] != expected:
+            raise ValueError(f"Expected {expected} queried actions, got {actions.shape[0]}")
+        return {
+            **data,
+            "past_actions": actions[: self.past_horizon],
+            "past_action_valid_mask": ~is_pad[: self.past_horizon],
+            "actions": actions[self.past_horizon :],
+            "actions_is_pad": is_pad[self.past_horizon :],
+        }
+
