@@ -0,0 +1,31 @@
+# Pi0.5 A2A normalization tests.
+from types import SimpleNamespace
+
+import numpy as np
+
+from openpi import transforms
+from openpi.policies.policy_config import input_norm_stats_for_model
+from openpi.shared.normalize import NormStats
+
+
+def test_a2a_inference_normalizes_past_actions_like_training():
+    action_stats = NormStats(
+        mean=np.zeros(2),
+        std=np.ones(2),
+        q01=np.array([-0.2, -1.0]),
+        q99=np.array([0.2, 1.0]),
+    )
+    stats = {"actions": action_stats}
+    input_stats = input_norm_stats_for_model(stats, SimpleNamespace(a2a_enabled=True))
+    raw = np.array([[0.1, 0.5]], dtype=np.float32)
+
+    result = transforms.Normalize(input_stats, use_quantiles=True)({"past_actions": raw.copy()})
+    expected = transforms.Normalize(stats, use_quantiles=True)({"actions": raw.copy()})
+
+    np.testing.assert_allclose(result["past_actions"], expected["actions"])
+    assert "past_actions" not in stats  # Output unnormalization keeps the original key set.
+
+
+def test_non_a2a_inference_keeps_original_normalization_keys():
+    stats = {"actions": object()}
+    assert input_norm_stats_for_model(stats, SimpleNamespace(a2a_enabled=False)) is stats
